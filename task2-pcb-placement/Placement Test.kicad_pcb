	(gr_rect
		(start 29.35 34.94)
		(end 129.35 74.94)
		(stroke
			(width 0.15)
			(type default)
		)
		(fill no)
		(layer "Edge.Cuts")
		(uuid "b806e652-25c1-4612-a8c5-0f4e2b4f2ce2")
	)
	(gr_text "Q1 a Q4 foram organizados em arranjo compacto para reduzir a área do loop de comutação e encurtar os caminhos de corrente entre chaveamento e indutor.\nIndutor (L2) posicionado próximo ao nó de comutação (SW), reduzindo indutâncias parasitas e EMI.\nRede snubber (C19 e R6) posicionada diretamente no nó SW para supressão de ringing."
		(at 107.85 25.94 0)
		(layer "Cmts.User")
		(uuid "0acd4dff-6ce8-4b7f-a78f-726b70b8dacd")
		(effects
			(font
				(size 1 0.7)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "L1 posicionado no caminho direto da alimentação, integrando o estágio de potência e contribuindo para a atenuação de ripple na entrada.\nC1 a C7 agrupados com orientação consistente, facilitando a formação de barramentos compactos de VIN e GND.\nC8 mantido próximo ao banco de entrada para suporte a transientes e estabilização da linha.\nPosicionamento orientado à minimização do loop de entrada de alta corrente, com objetivo de reduzir ripple conduzido e emissão EMI."
		(at 18.85 33.94 0)
		(layer "Cmts.User")
		(uuid "3e62fa1a-bab1-4bcc-b97e-adf517a1c4cf")
		(effects
			(font
				(size 1 0.7)
				(thickness 0.0375)
			)
			(justify left bottom)
		)
	)
	(gr_text "1/1"
		(at 100.35 121.44 0)
		(layer "Cmts.User")
		(uuid "639be792-27b8-4869-9dcb-5303bea097e3")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "DC/DC Buck Converter 24V to 5V - Component Placement"
		(at 99.85 127.94 0)
		(layer "Cmts.User")
		(uuid "ae595be3-f3db-409c-8761-fb0a3d784570")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "Apontamentos:\n- Restrição identificada: a área disponível e a posição dos conectores/furos mecânicos limitaram a liberdade de posicionamento absoluto dos blocos funcionais.\n- Restrição identificada: a necessidade de manter o estágio de potência compacto reduziu a separação física possível entre a região ruidosa de comutação e sinais sensíveis do controlador.\n- Limitação de design: esta etapa contempla o posicionamento inicial dos componentes; o desempenho final de EMI, retorno de corrente e acoplamento de ruído depende do roteamento, plano de terra e distribuição de vias.\n- Limitação de design: ajustes finos de orientação e distância entre componentes podem ser necessários após o roteamento dos caminhos críticos."
		(at 14.35 100.44 0)
		(layer "Cmts.User")
		(uuid "b3077d75-7241-43ce-b26c-403a1e6e64d1")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "Capacitores de saída (C13-C15) posicionados próximos ao indutor (L2) e agrupados de forma compacta para reduzir ripple e garantir baixa impedância.\nR4 foi mantido no caminho de potência para viabilizar sensoriamento de corrente com menor erro \nintroduzido por interconexões adicionais.\nLayout otimizado para minimizar o loop de saída e melhorar a resposta a transientes."
		(at 107.85 33.44 0)
		(layer "Cmts.User")
		(uuid "b53759db-343f-46cb-967b-66ea26941f38")
		(effects
			(font
				(size 1 0.7)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "U1 foi posicionado de forma central para reduzir o comprimento das interconexões críticas entre controle, sensoriamento e acionamento.\nOs resistores de gate foram posicionados de forma a permitir conexão direta e curta aos terminais dos MOSFETs, reduzindo efeitos parasitas e melhorando o controle de chaveamento.\nR7, C18 e C20 foram agrupados junto ao pino ITH para preservar a integridade da malha de compensação e garantir estabilidade dinâmica. \nC22, R10 e R11 foram mantidos próximos aos pinos de configuração do U1, evitando interferência da região de potência.\nC10 e C21 foram posicionados próximos aos respectivos nós funcionais do controlador para desacoplamento/filtragem local e redução de impedâncias parasitas. \nD1, R3 e C12 foram agrupados na região de bootstrap/driver, minimizando o comprimento das interconexões associadas a BOOST, INTVCC e SW.\nC11, R2 e C9 foram mantidos próximos à região de entrada/habilitação do U1, preservando a integridade do sinal de RUN e o desacoplamento local da alimentação do controlador."
		(at 31.35 87.44 0)
		(layer "Cmts.User")
		(uuid "df9acc73-91e9-4da7-af5b-91f2c86ac61b")
		(effects
			(font
				(size 1 0.7)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "4.0"
		(at 181.85 131.94 0)
		(layer "Cmts.User")
		(uuid "eb785413-2fbc-40ef-af6a-ed544592f883")
		(effects
